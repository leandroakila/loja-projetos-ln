rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'u4gmt1pDA3T7AyIKEdiLAztM6xH2';
    }
    function verifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email is string;
    }
    function hasGrant(id) {
      return verifiedEmail() && exists(/databases/$(database)/documents/grants/$(request.auth.token.email.lower() + '__' + id));
    }
    match /projects/{id} {
      allow get, list: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }
    match /projectFiles/{id} {
      allow get: if isAdmin() || hasGrant(id);
      allow list, create, update, delete: if isAdmin();
    }
    match /grants/{id} {
      allow get, list: if isAdmin() || (verifiedEmail() && resource.data.email == request.auth.token.email.lower());
      allow create, update, delete: if isAdmin();
    }
  }
}
